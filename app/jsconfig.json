{
    "compilerOptions": {
      "allowJs": true,
      "sourceMap": true,
      "baseUrl": ".",
      "paths": {
        "@/*": ["./src/*"]
      },
      "lib": ["esnext", "dom"],
      "types": []
    },
    "vueCompilerOptions": {
      // experimentalRuntimeMode 已废弃，现调整为 nativeTags，请升级 Volar 插件至最新版本
      "nativeTags": ["block", "component", "template", "slot"]
    },
    "include": ["src/**/*.js", "src/**/*.vue"]
  }
  