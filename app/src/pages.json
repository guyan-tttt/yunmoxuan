{
	"easycom": {
		"autoscan": true,
		"custom": {
			// uni-ui 规则如下配置
			"^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
		}
	},
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "云墨轩"
			}
		},
		{
			"path": "pages/article/index",
			"style": {
				"navigationBarTitleText": "云墨轩",
				"enablePullDownRefresh": true,
				"onReachBottomDistance": 50
			}
		},
		{
			"path": "pages/my/index",
			"style": {
				"navigationBarTitleText": "云墨轩"
			}
		},
		{
			"path": "pages/article-detail/index",
			"style": {
				"navigationBarTitleText": "云墨轩"
			}
		},
		{
			"path": "pages/blog-post/index",
			"style": {
				"navigationBarTitleText": "博文"
			}
		},
		{
			"path": "pages/picture/index",
			"style": {
				"navigationBarTitleText": "相册"
			}
		},
		{
			"path": "pages/trends/index",
			"style": {
				"navigationBarTitleText": "动态"
			}
		},
		{
			"path": "pages/guest/index",
			"style": {
				"navigationBarTitleText": "留言"
			}
		},
		{
			"path": "pages/source/index",
			"style": {
				"navigationBarTitleText": "资料"
			}
		},
		{
			"path": "pages/animation/index",
			"style": {
				"navigationBarTitleText": "追番"
			}
		},
		{
			"path": "pages/search/index",
			"style": {
				"navigationBarTitleText": "云墨轩"
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "uni-app",
		"navigationBarBackgroundColor": "#fff",
		"backgroundColor": "#fff"
	},
	"tabBar": {
		"color": "#7A7E83",
		"selectedColor": "#409EFF",
		"borderStyle": "black",
		"backgroundColor": "#ffffff",
		"list": [
			{
				"pagePath": "pages/index/index",
				"iconPath": "static/tabbar/home.png",
				"selectedIconPath": "static/tabbar/home-active.png",
				"text": "首页"
			},
			{
				"pagePath": "pages/article/index",
				"iconPath": "static/tabbar/article.png",
				"selectedIconPath": "static/tabbar/article-active.png",
				"text": "博文"
			},
			{
				"pagePath": "pages/my/index",
				"iconPath": "static/tabbar/my.png",
				"selectedIconPath": "static/tabbar/my-active.png",
				"text": "我的"
			}
		]
	},
	"subPackages": [
		{
			"root": "subPackages",
			"pages": [
				{
					"path": "userinfo/index",
					"style": {
						"navigationBarTitleText": "个人信息"
					}
				},
				{
					"path": "tags/index",
					"style": {
						"navigationBarTitleText": "tags"
					}
				},
				{
					"path": "setting/index",
					"style": {
						"navigationBarTitleText": "setting"
					}
				}
			]
		}
	],
	"preloadRule": {
		"pages/index/index": {
			"network": "all",
			"packages": [
				"subPackages"
			]
		}
	}
}